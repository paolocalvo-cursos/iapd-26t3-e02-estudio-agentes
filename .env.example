# =============================================================================
#  Estúdio — configuração das IAs
#  Mais fácil: botão 🔑 no app. Lá você cola a chave, ela fica cifrada no
#  cofre do sistema e vale mais que a do .env. Este arquivo continua valendo.
#  Copie para .env e preencha:   cp .env.example .env
#  O .env é relido a cada pedido (não precisa reiniciar o app) e nunca vai
#  para o git. Não cole chaves em chats nem em commits.
# =============================================================================


# -----------------------------------------------------------------------------
#  MODO GRATUITO  —  para quem NÃO tem assinatura nem crédito pago
# -----------------------------------------------------------------------------
#  MODO_GRATUITO=true  → TODOS os agentes (Maestro, Pixel, Chevron, Scout e
#                        Revisor) passam a usar o Gemini grátis. Nada pago é
#                        usado: as outras chaves e as CLIs abaixo são ignoradas.
#  MODO_GRATUITO=false → cada agente usa a sua própria IA (seções seguintes).
#
#  Para ligar:
#    1. Crie uma chave em https://aistudio.google.com/app/apikey
#       SEM ativar faturamento no projeto do Google Cloud. Se o faturamento
#       estiver ativo, o Google cobra pelo uso mesmo neste modo.
#    2. Coloque a chave em GEMINI_API_KEY (seção do Scout, mais abaixo).
#    3. Mude a linha abaixo para MODO_GRATUITO=true
#
#  Limites do plano grátis (o Google pode mudar; veja a sua cota no AI Studio):
#    - o Flash-Lite tem a maior cota grátis: na casa de 15 pedidos por minuto e
#      500 por dia;
#    - cada rodada do time faz de 3 a 4 pedidos;
#    - ao estourar, o agente avisa e a cota volta à meia-noite do Pacífico.
#  O texto enviado no plano grátis pode ser usado pelo Google para melhorar os
#  produtos dele: não mande código ou dados sigilosos.
MODO_GRATUITO=false

#  Modelo usado no modo gratuito (precisa ser um modelo da cota grátis):
GEMINI_MODELO_GRATUITO=gemini-3.5-flash-lite


# -----------------------------------------------------------------------------
#  MODO NORMAL  (MODO_GRATUITO=false) — cada IA com a sua chave
# -----------------------------------------------------------------------------
#  Para cada IA:
#    chave preenchida → usa a API oficial (cobrança por uso, exceto o Gemini
#                       sem faturamento ativado);
#    chave vazia      → usa a CLI logada na sua assinatura (claude, gemini,
#                       codex), sem cobrança por uso.

#  Pixel e Chevron (e Maestro, se você falar direto com ele)
#  Chave em https://platform.claude.com/settings/keys — API paga, sem plano grátis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

#  Scout — também é a chave usada pelo MODO GRATUITO
#  Chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

#  Revisor
#  Chave em https://platform.openai.com/api-keys — API paga, sem plano grátis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5


#  Provedores compatíveis com a API da OpenAI (sem CLI)
#  Groq — tem plano grátis. Chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

#  OpenRouter — muitos modelos com uma chave. Chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

#  Ollama — roda no seu computador, sem chave (https://ollama.com/download)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
#  PORTÃO DE TESTES — o Estúdio roda os testes depois de quem executa
# -----------------------------------------------------------------------------
#  Em branco, o Estúdio descobre: "test" do package.json → arquivos *.test.js
#  ou test/ (node --test) → test_*.py (pytest). Reprovou: volta para quem fez,
#  até 3 vezes. Mudou arquivo e não há teste: reprova e pede um teste.
COMANDO_TESTE=
#  PORTAO_TESTES=desligado pula o portão (o Revisor continua no fim).
PORTAO_TESTES=

#  Os testes rodam numa caixa de areia (bubblewrap, só Linux): enxergam só a
#  pasta do projeto, sem rede, sem a sua pasta pessoal e sem chaves de API.
#  Sem caixa de areia o portão NÃO roda. Para rodar sem isolamento mesmo assim
#  (por sua conta e risco): PORTAO_ISOLAMENTO=desligado
PORTAO_ISOLAMENTO=
#  Teste que precisa de internet: PORTAO_REDE=liberada
PORTAO_REDE=
